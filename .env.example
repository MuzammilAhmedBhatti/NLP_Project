MODPRECEDENT_LLM_BACKEND=anthropic
MODPRECEDENT_LLM_MODEL=claude-haiku-4-5-20251001
MODPRECEDENT_OLLAMA_URL=http://localhost:11434
MODPRECEDENT_OLLAMA_MODEL=llama3.1:8b
MODPRECEDENT_CHAT_BACKEND=anthropic
MODPRECEDENT_CHAT_MODEL=claude-haiku-4-5-20251001
MODPRECEDENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODPRECEDENT_API_KEY=
MODPRECEDENT_API_BASE_URL=https://api.openai.com/v1
# Optional on machines where the system drive has limited free space
MODPRECEDENT_MODEL_CACHE_DIR=
MODPRECEDENT_VISION_ENABLED=true
MODPRECEDENT_VISION_MODEL=Salesforce/blip-image-captioning-base
MODPRECEDENT_FALLBACK_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Keep the real key only in .env. Set both backends to transformers for fully local use.
CLAUDE_API_KEY=

